{
  "name": "favorites",
  "version": "0.1.0",
  "description": "A place to mirror favorite essays",
  "homepage": "https://github.com/theodore-s-beers/favorites#readme",
  "license": "MIT",
  "author": "Theo Beers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theodore-s-beers/favorites.git"
  },
  "type": "module",
  "main": "index.html",
  "scripts": {
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "format:html": "oxfmt --write '**/index.html'",
    "lint": "pnpm format:check && oxlint",
    "minify-html": "fd -e html ^index -x html-minifier-next --config-file html-minifier.json {} -o {}",
    "sort-manifest": "sort-package-json",
    "test": "echo 'Error: no test specified' && exit 1"
  },
  "devDependencies": {
    "html-minifier-next": "^8.10.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "sort-package-json": "^4.0.0"
  }
}
